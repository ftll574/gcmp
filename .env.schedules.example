# Official publication calendars work in the static app without this file.
# Copy to .env.schedules.local to enable an optional server-side provider.
# These are server-only values. Never prefix credentials with VITE_.
SCHEDULE_PROVIDER=tdx
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# Optional licensed alternative: set SCHEDULE_PROVIDER=cirium explicitly.
# It is never used as an automatic paid fallback.
CIRIUM_APP_ID=
CIRIUM_APP_KEY=
SCHEDULE_PORT=8787
SCHEDULE_DAILY_BUDGET=200
SCHEDULE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In a separate frontend .env.local file set: VITE_SCHEDULE_API_BASE=/api
# The deployed static site needs its own deployed HTTPS gateway URL instead.
