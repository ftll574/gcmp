{
  "name": "gcmp",
  "version": "1.9.0",
  "description": "Taiwan-first round-the-world (RTW) award route planner — validate multi-leg itineraries against alliance RTW and multi-carrier award rules, estimate award prices, and share the URL.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ftll574/gcmp.git"
  },
  "keywords": [
    "aviation",
    "round-the-world",
    "rtw",
    "award-travel",
    "mileage-runner",
    "flight-routing",
    "great-circle",
    "pqm",
    "rdm",
    "loyalty-programs",
    "oneworld",
    "star-alliance",
    "skyteam"
  ],
  "type": "module",
  "scripts": {
    "routes:build-flight-numbers": "tsx scripts/build-flight-number-layer.ts",
    "routes:build-runtime": "tsx scripts/build-runtime-route-network.ts",
    "routes:verify-runtime": "tsx scripts/verify-runtime-route-network.ts",
    "predev": "tsx scripts/build-runtime-route-network.ts && tsx scripts/build-landing-showcases.ts",
    "dev": "tsx scripts/dev.ts",
    "schedules:serve": "tsx scripts/serve-schedules.ts",
    "schedules:verify": "tsx scripts/verify-tdx.ts",
    "schedules:replay": "tsx scripts/replay-tdx.ts",
    "schedules:qa:replay": "tsx scripts/qa-tdx-replay.mjs",
    "schedules:calibrate:aerodatabox": "tsx scripts/calibrate-aerodatabox.ts",
    "schedules:crossvalidate:aerodatabox": "tsx scripts/crossvalidate-aerodatabox.ts",
    "schedules:controls:aerodatabox": "tsx scripts/aerodatabox-known-controls.ts",
    "coverage:alliances": "tsx scripts/report-alliance-coverage.ts",
    "coverage:flightconnections": "tsx scripts/report-flightconnections-parity.ts",
    "prebuild": "tsx scripts/build-runtime-route-network.ts && tsx scripts/build-landing-showcases.ts",
    "build": "tsc -b && tsx scripts/build-airline-pages.ts && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:airports": "tsx scripts/build-airports.ts",
    "build:airport-browse-regions": "tsx scripts/build-airport-browse-regions.ts",
    "build:landing-showcases": "tsx scripts/build-landing-showcases.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
